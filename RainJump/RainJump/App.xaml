<Application x:Class="RainJump.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>

        <!-- Color Palette -->
        <Color x:Key="SkyBlueColor">#C6DBEF</Color>
        <Color x:Key="PinkTitleColor">#FBAED2</Color>
        <Color x:Key="WhiteColor">#FFFFFF</Color>
        <Color x:Key="ButtonHoverColor">#F0F8FF</Color>
        <Color x:Key="ButtonPressColor">#DDEEFF</Color>
        <Color x:Key="SoftShadowColor">#88AACCDD</Color>

        <SolidColorBrush x:Key="SkyBlueBrush" Color="#C6DBEF"/>
        <SolidColorBrush x:Key="PinkTitleBrush" Color="#FBAED2"/>
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0E8F8"/>

        <!-- Main Menu Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#6AAED6"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Shadow layer -->
                            <Border CornerRadius="26"
                                    Background="#22AACCDD"
                                    Margin="2,4,0,0"/>
                            <!-- Main button surface -->
                            <Border x:Name="ButtonBorder"
                                    CornerRadius="26"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="2"
                                    BorderBrush="#D8EEF8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF6FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FBAED2"/>
                                <Setter Property="Foreground" Value="#FBAED2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDEEF8"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FBAED2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
