<Window x:Class="RainJump.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rain Jump"
        Width="420"
        Height="700"
        MinWidth="280"
        MinHeight="467"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource GameBgBlueBrush}"
        SizeChanged="Window_SizeChanged">

    <Viewbox Stretch="Uniform">
        <Grid Width="420" Height="700"
              Background="{DynamicResource GameBgBlueBrush}">

    <Grid x:Name="RootGrid">

        <ContentControl x:Name="ViewHost"
                        Visibility="Collapsed"
                        Panel.ZIndex="5"/>

        <!-- ═══════════════════════════════════ -->
        <!--           MAIN MENU VIEW            -->
        <!-- ═══════════════════════════════════ -->
        <Grid x:Name="MainMenuView">

            <!-- Decorative background bubbles -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Canvas.Left="-60"  Canvas.Top="-60"   Width="220" Height="220" Fill="{DynamicResource BubbleWhiteBrush}"/>
                <Ellipse Canvas.Right="-40" Canvas.Top="80"    Width="160" Height="160" Fill="{DynamicResource BubbleWhiteBrush}"/>
                <Ellipse Canvas.Left="20"   Canvas.Top="280"   Width="80"  Height="80"  Fill="{DynamicResource BubbleWhiteFaintBrush}"/>
                <Ellipse Canvas.Right="-70" Canvas.Bottom="-50" Width="250" Height="250" Fill="{DynamicResource BubbleWhiteBrush}"/>
                <Ellipse Canvas.Left="30"   Canvas.Bottom="120" Width="55"  Height="55"  Fill="{DynamicResource BubbleWhiteFaintBrush}"/>
                <Ellipse Canvas.Left="180"  Canvas.Top="160"   Width="24"  Height="24"  Fill="{DynamicResource PinkAccentFaintBrush}"/>

                <Path Canvas.Left="60"  Canvas.Top="120" Fill="{DynamicResource PinkAccentFaintBrush}"
                      Data="M 8,0 C 8,0 16,10 16,16 A 8,8 0 0 1 0,16 C 0,10 8,0 8,0 Z"/>
                <Path Canvas.Left="330" Canvas.Top="200" Fill="{DynamicResource BubbleWhiteBrush}"
                      Data="M 8,0 C 8,0 16,10 16,16 A 8,8 0 0 1 0,16 C 0,10 8,0 8,0 Z"/>
                <Path Canvas.Left="50"  Canvas.Top="500" Fill="{DynamicResource PinkAccentFaintBrush}"
                      Data="M 6,0 C 6,0 12,8 12,12 A 6,6 0 0 1 0,12 C 0,8 6,0 6,0 Z"/>
                <Path Canvas.Right="60" Canvas.Bottom="200" Fill="{DynamicResource BubbleWhiteBrush}"
                      Data="M 6,0 C 6,0 12,8 12,12 A 6,6 0 0 1 0,12 C 0,8 6,0 6,0 Z"/>
            </Canvas>

            <!-- Main content stack -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,-40,0,0">

                <!-- ── TITLE ── -->
                <Grid Margin="0,0,0,60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column: RAIN / JUMP -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="R" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="A" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="I" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="N" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="J" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="U" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="M" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="P" Style="{DynamicResource TitleLetterStyle}"><TextBlock.Effect><DropShadowEffect Color="{StaticResource TitleShadowColor}" BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/></TextBlock.Effect></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Vertical divider -->
                    <Border Grid.Column="1"
                            Width="3"
                            Background="{DynamicResource PinkAccentSubtleBrush}"
                            CornerRadius="2"
                            VerticalAlignment="Stretch"
                            Margin="0,8,0,8"/>

                    <!-- Right column: tagline -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="☁" FontSize="32"
                                   Foreground="{DynamicResource PinkAccentMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="j u m p"
                                   FontFamily="{StaticResource TitleLightFont}"
                                   FontSize="{StaticResource SubtitleFontSize}"
                                   Foreground="{DynamicResource PinkAccentSoftBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="h i g h e r"
                                   FontFamily="{StaticResource TitleLightFont}"
                                   FontSize="{StaticResource SubtitleFontSize}"
                                   Foreground="{DynamicResource PinkAccentSoftBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="💧" FontSize="24"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ── BUTTONS ── -->
                <StackPanel HorizontalAlignment="Center">
                    <Button x:Name="PlayButton"    Content="Play"
                            Style="{DynamicResource MenuButtonStyle}"
                            Margin="0,0,0,18" Click="PlayButton_Click"/>
                    <Button x:Name="RecordsButton" Content="Records"
                            Style="{DynamicResource MenuButtonStyle}"
                            Margin="0,0,0,18" Click="RecordsButton_Click"/>
                    <Button x:Name="SettingsButton" Content="Settings"
                            Style="{DynamicResource MenuButtonStyle}"
                            Margin="0,0,0,18" Click="SettingsButton_Click"/>
                    <Button x:Name="LogoutButton"  Content="Log Out"
                            Style="{DynamicResource MenuButtonStyle}"
                            Margin="0,0,0,18" Click="LogoutButton_Click"/>
                    <Button x:Name="QuitButton"    Content="Quit"
                            Style="{DynamicResource MenuButtonStyle}"
                            Click="QuitButton_Click"/>
                </StackPanel>

                <!-- Welcome label + version -->
                <TextBlock x:Name="WelcomeLabel"
                           Text="Playing as Guest"
                           FontFamily="{DynamicResource TitleFont}"
                           FontSize="13"
                           Foreground="{DynamicResource PinkAccentBrush}"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           Margin="0,20,0,0"/>
                <TextBlock Text="v0.1"
                           FontFamily="{StaticResource VersionFont}"
                           FontSize="{StaticResource VersionFontSize}"
                           Foreground="{DynamicResource VersionTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>
        </Grid>

    </Grid><!-- RootGrid -->
    </Grid><!-- Viewbox inner Grid -->
    </Viewbox>
</Window>
