<Window x:Class="RainJump.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rain Jump"
        Width="420"
        Height="700"
        MinWidth="280"
        MinHeight="467"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#C6DBEF"
        SizeChanged="Window_SizeChanged">

    <!-- ViewBox scales everything uniformly from the 420×700 design size -->
    <Viewbox Stretch="Uniform">
        <Grid Width="420" Height="700" Background="#C6DBEF">

    <!-- Root frame that will host different views (menu, game, records) -->
    <Grid x:Name="RootGrid">

        <!-- Dynamic view host (GameView / RecordsView swap in here) -->
        <ContentControl x:Name="ViewHost"
                        Visibility="Collapsed"
                        Panel.ZIndex="5"/>

        <!-- ═══════════════════════════════════ -->
        <!--           MAIN MENU VIEW            -->
        <!-- ═══════════════════════════════════ -->
        <Grid x:Name="MainMenuView">

            <!-- Decorative background bubbles -->
            <Canvas IsHitTestVisible="False">

                <!-- Large soft circle top-left -->
                <Ellipse Canvas.Left="-60" Canvas.Top="-60"
                         Width="220" Height="220"
                         Fill="#18FFFFFF"/>

                <!-- Medium circle top-right -->
                <Ellipse Canvas.Right="-40" Canvas.Top="80"
                         Width="160" Height="160"
                         Fill="#18FFFFFF"/>

                <!-- Small circle mid-left -->
                <Ellipse Canvas.Left="20" Canvas.Top="280"
                         Width="80" Height="80"
                         Fill="#14FFFFFF"/>

                <!-- Large soft circle bottom-right -->
                <Ellipse Canvas.Right="-70" Canvas.Bottom="-50"
                         Width="250" Height="250"
                         Fill="#18FFFFFF"/>

                <!-- Tiny circle bottom-left -->
                <Ellipse Canvas.Left="30" Canvas.Bottom="120"
                         Width="55" Height="55"
                         Fill="#14FFFFFF"/>

                <!-- Tiny accent dot -->
                <Ellipse Canvas.Left="180" Canvas.Top="160"
                         Width="24" Height="24"
                         Fill="#22FBAED2"/>

                <!-- Rain drop decorations -->
                <Path Canvas.Left="60" Canvas.Top="120"
                      Fill="#22FBAED2"
                      Data="M 8,0 C 8,0 16,10 16,16 A 8,8 0 0 1 0,16 C 0,10 8,0 8,0 Z"/>

                <Path Canvas.Left="330" Canvas.Top="200"
                      Fill="#22FFFFFF"
                      Data="M 8,0 C 8,0 16,10 16,16 A 8,8 0 0 1 0,16 C 0,10 8,0 8,0 Z"/>

                <Path Canvas.Left="50" Canvas.Top="500"
                      Fill="#22FBAED2"
                      Data="M 6,0 C 6,0 12,8 12,12 A 6,6 0 0 1 0,12 C 0,8 6,0 6,0 Z"/>

                <Path Canvas.Right="60" Canvas.Bottom="200"
                      Fill="#22FFFFFF"
                      Data="M 6,0 C 6,0 12,8 12,12 A 6,6 0 0 1 0,12 C 0,8 6,0 6,0 Z"/>

            </Canvas>

            <!-- Main content stack -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,-40,0,0">

                <!-- ── TITLE "RAIN JUMP" in 2 columns ── -->
                <Grid Margin="0,0,0,60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column: R, I, N -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                        <!-- "RAIN" -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="R"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="A"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="I"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="N"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <!-- "JUMP" -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="J"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="U"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="M"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="P"
                                       FontFamily="Bahnschrift"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="#FBAED2"
                                       LineHeight="72"
                                       TextOptions.TextFormattingMode="Display">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#CC8890AA"
                                                      BlurRadius="8"
                                                      ShadowDepth="3"
                                                      Direction="270"
                                                      Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>

                    <!-- Vertical divider -->
                    <Border Grid.Column="1"
                            Width="3"
                            Background="#44FBAED2"
                            CornerRadius="2"
                            VerticalAlignment="Stretch"
                            Margin="0,8,0,8"/>

                    <!-- Right column: subtitle / tagline stacked vertically -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="☁"
                                   FontSize="32"
                                   Foreground="#AAFBAED2"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="j u m p"
                                   FontFamily="Bahnschrift Light"
                                   FontSize="22"
                                   Foreground="#BBFBAED2"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="h i g h e r"
                                   FontFamily="Bahnschrift Light"
                                   FontSize="22"
                                   Foreground="#BBFBAED2"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="💧"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Grid>

                <!-- ── BUTTONS ── -->
                <StackPanel HorizontalAlignment="Center">

                    <!-- Play Button -->
                    <Button x:Name="PlayButton"
                            Content="Play"
                            Style="{StaticResource MenuButtonStyle}"
                            Margin="0,0,0,18"
                            Click="PlayButton_Click"/>

                    <!-- Records Button -->
                    <Button x:Name="RecordsButton"
                            Content="Records"
                            Style="{StaticResource MenuButtonStyle}"
                            Margin="0,0,0,18"
                            Click="RecordsButton_Click"/>

                    <!-- Quit Button -->
                    <Button x:Name="QuitButton"
                            Content="Quit"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="QuitButton_Click"/>

                </StackPanel>

                <!-- Version label -->
                <TextBlock Text="v0.1"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#668ABACC"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"/>

            </StackPanel>

        </Grid>

    </Grid><!-- RootGrid -->

    </Grid><!-- Viewbox inner Grid -->
    </Viewbox>
</Window>
