<UserControl x:Class="RainJump.Views.CustomizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource GameBgBlueBrush}">

    <Grid>
        <!-- Decorative bubbles -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-60"  Canvas.Top="-60"    Width="200" Height="200" Fill="{StaticResource BubbleWhiteBrush}"/>
            <Ellipse Canvas.Right="-40" Canvas.Bottom="-40" Width="220" Height="220" Fill="{StaticResource BubbleWhiteBrush}"/>
        </Canvas>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="Choose Theme"
                       FontFamily="{StaticResource TitleFont}"
                       FontSize="38"
                       FontWeight="Bold"
                       Foreground="{StaticResource PinkAccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource TitleShadowColor}"
                                      BlurRadius="8" ShadowDepth="3"
                                      Direction="270" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Active theme label -->
            <TextBlock x:Name="ActiveThemeLabel"
                       FontFamily="{StaticResource TitleFont}"
                       FontSize="15"
                       Foreground="{StaticResource PinkAccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Theme cards row -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,40">

                <!-- ── Rivulet card ── -->
                <Border x:Name="RivuletCard"
                        Width="130" Height="180"
                        CornerRadius="16"
                        BorderThickness="3"
                        Margin="0,0,20,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="RivuletCard_Click">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C6DBEF" Offset="0"/>
                            <GradientStop Color="#F8DEEB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Mini player preview -->
                        <Canvas Width="50" Height="50" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <!-- Body -->
                            <Ellipse Canvas.Left="5" Canvas.Top="8" Width="40" Height="40"
                                     Fill="#ADD8F8" Stroke="#E8EFF5" StrokeThickness="2"/>
                            <!-- Eyes -->
                            <Ellipse Canvas.Left="13" Canvas.Top="20" Width="10" Height="10" Fill="#FBAED2"/>
                            <Ellipse Canvas.Left="27" Canvas.Top="20" Width="10" Height="10" Fill="#FBAED2"/>
                        </Canvas>
                        <TextBlock Text="Rivulet"
                                   FontFamily="Bahnschrift"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#FBAED2"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Kind soul"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#88FBAED2"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ── Artificer card ── -->
                <Border x:Name="ArtificerCard"
                        Width="130" Height="180"
                        CornerRadius="16"
                        BorderThickness="3"
                        Cursor="Hand"
                        MouseLeftButtonUp="ArtificerCard_Click">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF8780" Offset="0"/>
                            <GradientStop Color="#F7F5BC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Mini player preview with bruise + scar -->
                        <Canvas Width="50" Height="58" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Ellipse Canvas.Left="5" Canvas.Top="8" Width="40" Height="40"
                                     Fill="#801818" Stroke="#551010" StrokeThickness="2"/>
                            <!-- Left eye: D-shape angry (high outside, low inside) -->
                            <Path Canvas.Left="8" Canvas.Top="21" Fill="White"
                                  Data="M 0,2 L 12,5 L 12,8 A 6,6 0 0 1 0,8 Z"/>
                            <!-- Right bruise circle -->
                            <Ellipse Canvas.Left="27" Canvas.Top="20" Width="15" Height="15"
                                     Fill="#420303"/>
                            <!-- Scar diagonal (drawn first, under slit) -->
                            <Path Canvas.Left="31" Canvas.Top="21"
                                  Stroke="#944547" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 2,0 L 7,13"/>
                            <!-- White slit (drawn on top of scar) -->
                            <Path Canvas.Left="29" Canvas.Top="27"
                                  Stroke="White" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 0,0 L 10,0"/>
                        </Canvas>
                        <TextBlock Text="Artificer"
                                   FontFamily="Bahnschrift"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#420C09"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Worn-out"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#88420C09"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Back -->
            <Button x:Name="BackButton" Content="Back"
                    Style="{StaticResource MenuButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="BackButton_Click"/>

        </StackPanel>
    </Grid>
</UserControl>
