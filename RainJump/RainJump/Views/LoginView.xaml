<UserControl x:Class="RainJump.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource GameBgBlueBrush}">

    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-60" Canvas.Top="-60" Width="200" Height="200" Fill="{DynamicResource BubbleWhiteBrush}"/>
            <Ellipse Canvas.Right="-40" Canvas.Bottom="-40" Width="200" Height="200" Fill="{DynamicResource BubbleWhiteBrush}"/>
        </Canvas>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">

            <!-- Title -->
            <TextBlock Text="Login"
                       FontFamily="{DynamicResource TitleFont}"
                       FontSize="44" FontWeight="Bold"
                       Foreground="{DynamicResource PinkAccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,36">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource TitleShadowColor}"
                                      BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Nickname -->
            <TextBlock Text="Nickname"
                       FontFamily="{DynamicResource TitleFont}"
                       FontSize="14"
                       Foreground="{DynamicResource PinkAccentBrush}"
                       Margin="4,0,0,6"/>
            <Border CornerRadius="12" Background="White" BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="2" Margin="0,0,0,16">
                <TextBox x:Name="NicknameBox"
                         FontFamily="{DynamicResource UiFont}"
                         FontSize="16"
                         Foreground="{DynamicResource ButtonFgBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,8"/>
            </Border>

            <!-- Password -->
            <TextBlock Text="Password"
                       FontFamily="{DynamicResource TitleFont}"
                       FontSize="14"
                       Foreground="{DynamicResource PinkAccentBrush}"
                       Margin="4,0,0,6"/>
            <Border CornerRadius="12" Background="White" BorderBrush="{DynamicResource ButtonBorderBrush}"
                    BorderThickness="2" Margin="0,0,0,8">
                <PasswordBox x:Name="PasswordBox"
                             FontFamily="{DynamicResource UiFont}"
                             FontSize="16"
                             Foreground="{DynamicResource ButtonFgBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,8"/>
            </Border>

            <!-- Error label -->
            <TextBlock x:Name="ErrorLabel"
                       FontFamily="{DynamicResource TitleFont}"
                       FontSize="13"
                       Foreground="#E05555"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <Button Content="Login"
                    Style="{DynamicResource MenuButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14"
                    Click="LoginButton_Click"/>

            <Button Content="Cancel"
                    Style="{DynamicResource MenuButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</UserControl>
