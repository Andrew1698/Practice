<UserControl x:Class="RainJump.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#C6DBEF">

    <Grid>
        <!-- Decorative bubbles -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-60" Canvas.Top="-60" Width="200" Height="200" Fill="#18FFFFFF"/>
            <Ellipse Canvas.Right="-40" Canvas.Bottom="-40" Width="220" Height="220" Fill="#18FFFFFF"/>
        </Canvas>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="Best Score:"
                       FontFamily="Bahnschrift"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#FBAED2"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#CC8890AA" BlurRadius="8" ShadowDepth="3"
                                      Direction="270" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Score value -->
            <TextBlock x:Name="BestScoreValue"
                       Text="0"
                       FontFamily="Bahnschrift"
                       FontSize="64"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,50"/>

            <!-- Back button -->
            <Button x:Name="BackButton"
                    Content="Back"
                    Style="{StaticResource MenuButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18"
                    Click="BackButton_Click"/>

            <!-- Reset record button -->
            <Button x:Name="ResetButton"
                    Content="Reset"
                    Style="{StaticResource MenuButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="ResetButton_Click"/>

        </StackPanel>
    </Grid>
</UserControl>
