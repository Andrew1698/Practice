<UserControl x:Class="RainJump.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource GameBgBlueBrush}"
             Focusable="True">

    <Grid x:Name="RootGrid">

        <!-- ── GAME CANVAS ── -->
        <Canvas x:Name="GameCanvas"
                Background="{DynamicResource GameBgBlueBrush}"
                ClipToBounds="True"/>

        <!-- ── SCORE (top-left) ── -->
        <TextBlock x:Name="ScoreText"
                   Text="Score: 0"
                   FontFamily="{StaticResource TitleFont}"
                   FontSize="{StaticResource ScoreFontSize}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource ScoreTextBrush}"
                   Margin="12,10,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Panel.ZIndex="10"/>

        <!-- ── START PROMPT ── -->
        <StackPanel x:Name="StartPrompt"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,-160,0,0"
                    Panel.ZIndex="10"
                    IsHitTestVisible="False">
            <TextBlock Text="Press"
                       FontFamily="{StaticResource TitleFont}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PinkAccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="left or right"
                       FontFamily="{StaticResource TitleFont}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PinkAccentBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ── DEATH OVERLAY ── -->
        <Grid x:Name="DeathOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="20">

            <Rectangle Fill="#88000000"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock x:Name="FinalScoreText"
                           Text="Score: 0"
                           FontFamily="{StaticResource TitleFont}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Button x:Name="TryAgainButton" Content="Try Again"
                        Style="{StaticResource MenuButtonStyle}"
                        Margin="0,0,0,18"
                        Click="TryAgainButton_Click"/>

                <Button x:Name="LeaveButton" Content="Leave"
                        Style="{StaticResource MenuButtonStyle}"
                        Click="LeaveButton_Click"/>

            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
